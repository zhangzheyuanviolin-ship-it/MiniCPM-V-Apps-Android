    <string name="inference_settings">Inference settings</string>
    <string name="settings_intro">Settings are saved per model. V4.7 declares a 262144-token total window; the phone demo defaults to 4096 and does not guarantee the model maximum on phones. This build defaults to 16384 context and 8192 output tokens. Tokens are not characters.</string>
    <string name="settings_context">Total context window (tokens)</string>
    <string name="settings_context_help">Includes history, images, input and output. Larger windows use more memory. Saving a changed window clears the conversation and recreates its cache. Other settings apply next turn and preserve the conversation.</string>
    <string name="settings_token_choice">%1$d tokens</string>
    <string name="settings_output">Maximum new tokens per reply</string>
    <string name="settings_output_help">At least 1 and at most context minus 128. Actual remaining context can stop output earlier. Thinking tokens count toward this limit.</string>
    <string name="settings_temperature">Temperature</string>
    <string name="settings_temperature_help">0 to 2. Zero is greedy sampling. Official V4.7 model setting: 1.0.</string>
    <string name="settings_top_p">Top-P cumulative probability</string>
    <string name="settings_top_p_help">Greater than 0, up to 1; 1 disables it. Official V4.7 setting: 0.95.</string>
    <string name="settings_top_k">Top-K candidates</string>
    <string name="settings_top_k_help">0 to 1000; zero is unlimited. Official V4.7 setting: 20.</string>
    <string name="settings_min_p">Min-P relative probability</string>
    <string name="settings_min_p_help">0 to 1; zero disables it (default).</string>
    <string name="settings_repeat">Repetition penalty</string>
    <string name="settings_repeat_help">0.5 to 2; 1 disables it. Greater than 1 discourages repeats. Default: 1.</string>
    <string name="settings_repeat_window">Repetition window (tokens)</string>
    <string name="settings_repeat_window_help">Most recent 0 to 4096 text tokens, including input and generated text. Zero disables it. Default: 64.</string>
    <string name="settings_seed">Random seed</string>
    <string name="settings_seed_help">-1 is random. Fixed seeds: 0 to 2147483647. Default: -1.</string>
